# Must match the token you type into the monitor ("token change-me").
INGEST_TOKEN=change-me
POSTGRES_PASSWORD=aquasense

# Alert limits. Defaults suit a chlorinated pool; leave one empty to turn it off.
PH_MIN=7.2
PH_MAX=7.8
ORP_MIN=650
ORP_MAX=
TEMP_MIN=
TEMP_MAX=32
# Alert only after a value has been out of range this long (minutes).
ALERT_MINUTES=15
# "Monitor offline" after this many minutes without data.
STALE_MINUTES=5

# Optional phone notifications: e.g. https://ntfy.sh/your-secret-topic
ALERT_WEBHOOK_URL=
