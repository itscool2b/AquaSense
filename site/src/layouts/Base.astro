---
import "../styles/global.css";
const { title = "AquaSense", description = "A solar buoy that sits on the water, measures a few stats, uses cellular internet to send them to a website you host." } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=IBM+Plex+Sans:wght@400;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="wrap">
      <nav class="nav">
        <a class="wordmark" href={base}>
          <img src={`${base}images/wordmark.svg`} width="28" height="28" alt="" />
          AquaSense
        </a>
        <div class="nav-links">
          <a href={`${base}build/`}>Build</a>
          <a href={`${base}build/bom/`}>BOM</a>
          <a href={`${base}dashboard/`}>Dashboard</a>
          <a href={`${base}docs/accuracy/`}>Limits</a>
        </div>
      </nav>
      <slot />
      <footer class="footer">
        Open hardware. We host nothing. MIT firmware · CERN-OHL-S hardware · CC BY 4.0 docs.
      </footer>
    </div>
  </body>
</html>
