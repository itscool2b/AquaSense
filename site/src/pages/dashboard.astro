---
import Base from "../layouts/Base.astro";
---
<Base title="Dashboard (simulated) — AquaSense">
  <p class="kicker sim">Simulated · fixture JSON · not a live fleet</p>
  <h1>Dashboard</h1>
  <p class="lede">A solar buoy that sits on the water, measures a few stats, uses cellular internet to send them to a website you host.</p>
  <div class="callout">
    Every number on this page is <strong>simulated fixture data</strong>. There is no AquaSense cloud and no live buoy here.
    For real POSTs, run <code>docker compose up</code> and point the board at <em>your</em> URL.
  </div>
  <p><a class="btn" href={`${import.meta.env.BASE_URL}build/host/`}>Run your own ingest</a></p>
  <div id="app" style="margin-top:2rem"></div>
</Base>

<script>
  function mulberry32(a) {
    return function () {
      let t = (a += 0x6d2b79f5);
      t = Math.imul(t ^ (t >>> 15), t | 1);
      t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  const now = Date.parse("2026-08-12T18:00:00Z");
  const rand = mulberry32(42);
  const series = [];
  for (let i = 672; i >= 0; i--) {
    const t = now - i * 15 * 60 * 1000;
    const wiggle = (amp) => (rand() - 0.5) * amp;
    series.push({
      ts: new Date(t).toISOString(),
      lat: 27.331,
      lon: -82.546,
      temp_c: 28.4 + wiggle(0.8),
      ph: 7.82 + wiggle(0.12),
      sal_psu: 27.4 + wiggle(0.6),
      do_mgl: 5.6 + wiggle(0.7),
      depth_m: 1.4 + wiggle(0.15),
      batt_v: 3.91 + wiggle(0.08),
      rssi: -89,
    });
  }
  const latest = series[series.length - 1];

  function drawChart(canvas, points, key, color, hypoxia) {
    const ctx = canvas.getContext("2d");
    const w = canvas.width;
    const h = canvas.height;
    ctx.clearRect(0, 0, w, h);
    const vals = points.map((p) => p[key]);
    const min = Math.min(...vals);
    const max = Math.max(...vals);
    const span = max - min || 1;
    if (hypoxia != null) {
      const y = h - 16 - ((2 - min) / span) * (h - 28);
      ctx.strokeStyle = "#c4452d";
      ctx.setLineDash([4, 4]);
      ctx.beginPath();
      ctx.moveTo(8, y);
      ctx.lineTo(w - 8, y);
      ctx.stroke();
      ctx.setLineDash([]);
    }
    ctx.strokeStyle = color;
    ctx.lineWidth = 2;
    ctx.beginPath();
    points.forEach((p, i) => {
      const x = 8 + (i / Math.max(points.length - 1, 1)) * (w - 16);
      const y = h - 16 - ((p[key] - min) / span) * (h - 28);
      if (i === 0) ctx.moveTo(x, y);
      else ctx.lineTo(x, y);
    });
    ctx.stroke();
  }

  const gauges = [
    ["Temperature", latest.temp_c, "°C"],
    ["pH", latest.ph, ""],
    ["Salinity", latest.sal_psu, "PSU"],
    ["DO", latest.do_mgl, "mg/L"],
    ["Depth", latest.depth_m, "m"],
    ["Battery", latest.batt_v, "V"],
  ];

  const el = document.getElementById("app");
  el.innerHTML = `
    <p class="muted">Last fixture sample · ${latest.ts} · ${latest.lat}, ${latest.lon} · LTE ${latest.rssi} dBm · <span class="sim">simulated</span></p>
    <div class="gauges">
      ${gauges.map(([n, v, u]) => `<div class="gauge"><div class="v">${Number(v).toFixed(2)}<small> ${u}</small></div><div class="n">${n}</div></div>`).join("")}
    </div>
    <div class="chart-head">
      <h2>Charts</h2>
      <div class="seg">
        <button type="button" data-range="24h" class="on">24h</button>
        <button type="button" data-range="7d">7d</button>
      </div>
    </div>
    <p class="muted">15-minute cadence, same as firmware. Dashed rust line on DO is the 2 mg/L hypoxia rule of thumb — not an FDEP lab limit.</p>
    <div class="chart-grid" id="charts"></div>
    <h2>Map</h2>
    <p class="muted">Fixture pin at 27.331, −82.546 (Sarasota Bay area). OpenStreetMap tiles, not a live GPS track.</p>
    <iframe class="map" title="Fixture buoy location" src="https://www.openstreetmap.org/export/embed.html?bbox=-82.62%2C27.27%2C-82.47%2C27.39&amp;layer=mapnik&amp;marker=27.331%2C-82.546"></iframe>
  `;

  const specs = [
    ["temp_c", "Temperature °C", "#1fa6a0", false],
    ["do_mgl", "DO mg/L", "#1fa6a0", true],
    ["sal_psu", "Salinity PSU", "#e6d5b8", false],
    ["batt_v", "Battery V", "#c4452d", false],
  ];

  function render(range) {
    const cutoff = range === "24h" ? now - 24 * 3600 * 1000 : now - 7 * 24 * 3600 * 1000;
    const pts = series.filter((p) => Date.parse(p.ts) >= cutoff);
    const host = document.getElementById("charts");
    host.innerHTML = specs
      .map(
        ([key, label], i) =>
          `<div class="chart-card"><div class="n">${label}</div><canvas id="c${i}" width="640" height="160"></canvas></div>`
      )
      .join("");
    specs.forEach(([key, , color, hyp], i) => {
      drawChart(document.getElementById("c" + i), pts, key, color, hyp);
    });
  }

  render("24h");
  el.querySelectorAll(".seg button").forEach((btn) => {
    btn.addEventListener("click", () => {
      el.querySelectorAll(".seg button").forEach((b) => b.classList.remove("on"));
      btn.classList.add("on");
      render(btn.dataset.range);
    });
  });
</script>
